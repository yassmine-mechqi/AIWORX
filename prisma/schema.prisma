// =====================================================
// AIWORX
// Prisma ORM 8 Contract / PSL
// PostgreSQL
// =====================================================

// =====================================================
// ENUMS
// =====================================================
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  CLIENT
  PROVIDER
  ADVISOR
  QUALITY_EXPERT
  FINANCE_ADMIN
  ADMIN
}

enum ProviderVerificationStatus {
  DRAFT
  IN_REVIEW
  ADDITIONAL_INFO_REQUIRED
  TEST
  VERIFIED
  SUSPENDED
  REJECTED
}

enum ProjectRequestStatus {
  DRAFT
  SUBMITTED
  IN_QUALIFICATION
  ADDITIONAL_INFO_REQUIRED
  VALIDATED
  PUBLISHED
  SUSPENDED
  ASSIGNED
  CANCELLED
  ARCHIVED
}

// =====================================================
// USER
// =====================================================
model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  passwordHash           String?
  firstName              String
  lastName               String
  phone                  String?
  status                 UserStatus               @default(PENDING)

  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // Relations
  ownedOrganizations     Organization[]           @relation("OrganizationOwner")

  memberships            OrganizationMembership[]

  roleAssignments        RoleAssignment[]         @relation("UserRoleAssignments")

  createdRoleAssignments RoleAssignment[]         @relation("RoleAssignmentCreator")

  providerProfile        ProviderProfile?

  reviewedVerifications  ProviderVerification[]   @relation("VerificationReviewer")

  projectRequests        ProjectRequest[]         @relation("ProjectClient")

  createdPermissions     Permission[]             @relation("PermissionCreator")
}

// =====================================================
// ORGANIZATION
// =====================================================
model Organization {
  id               String                   @id @default(uuid())
  name             String
  legalName        String?
  description      String?

  status           OrganizationStatus       @default(ACTIVE)

  country          String?
  city             String?
  address          String?
  postalCode       String?

  website          String?

  ownerId          String

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // Relations
  owner            User                     @relation("OrganizationOwner", fields:[ownerId], references:[id])

  memberships      OrganizationMembership[]

  projectRequests  ProjectRequest[]

  providerProfiles ProviderProfile[]

  roleAssignments  RoleAssignment[]
}

// =====================================================
// ORGANIZATION MEMBERSHIP
// =====================================================
model OrganizationMembership {
  id             String               @id @default(uuid())
  userId         String
  organizationId String

  isActive       Boolean              @default(true)

  joinedAt       DateTime             @default(now())
  leftAt         DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  user           User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  organization   Organization         @relation(fields:[organizationId], references:[id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// =====================================================
// ROLE
// =====================================================
model Role {
  id          String               @id @default(uuid())

  name        RoleName             @unique
  description String?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  assignments RoleAssignment[]

  permissions RolePermission[]
}

// =====================================================
// PERMISSION
// =====================================================
model Permission {
  id          String               @id @default(uuid())

  code        String               @unique
  description String?

  createdById String?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  createdBy   User?                @relation("PermissionCreator", fields:[createdById], references:[id])

  roles       RolePermission[]

  @@index([createdById])
}

// =====================================================
// ROLE ASSIGNMENT
// =====================================================
model RoleAssignment {
  id             String               @id @default(uuid())

  userId         String
  roleId         String

  organizationId String?
  createdById    String?

  isActive       Boolean              @default(true)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  user           User                 @relation("UserRoleAssignments", fields:[userId], references:[id], onDelete: Cascade)

  role           Role                 @relation(fields:[roleId], references:[id], onDelete: Cascade)

  organization   Organization?        @relation(fields:[organizationId], references:[id], onDelete: Cascade)

  createdBy      User?                @relation("RoleAssignmentCreator", fields:[createdById], references:[id])

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([createdById])
}

// =====================================================
// ROLE PERMISSION
// =====================================================
model RolePermission {
  id           String     @id @default(uuid())

  roleId       String
  permissionId String

  createdAt    DateTime   @default(now())

  // Relations
  role         Role       @relation(fields:[roleId], references:[id], onDelete: Cascade)

  permission   Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// =====================================================
// PROVIDER PROFILE
// =====================================================
model ProviderProfile {
  id              String                 @id @default(uuid())

  userId          String                 @unique
  organizationId  String?

  displayName     String?
  headline        String?
  bio             String?

  country         String?
  city            String?
  address         String?

  skills          Json?
  categories      Json?
  sectors         Json?
  portfolio       Json?

  yearsExperience Int?

  hourlyRate      Decimal?
  currency        String?                @default("MAD")

  score           Decimal?

  isAvailable     Boolean                @default(true)

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  user            User                   @relation(fields:[userId], references:[id], onDelete: Cascade)

  organization    Organization?          @relation(fields:[organizationId], references:[id])

  verifications   ProviderVerification[]

  projectRequests ProjectRequest[]

  @@index([organizationId])
  @@index([isAvailable])
}

// =====================================================
// PROVIDER VERIFICATION
// =====================================================
model ProviderVerification {
  id                String                     @id @default(uuid())

  providerProfileId String
  reviewedById      String?

  status            ProviderVerificationStatus @default(DRAFT)

  submittedAt       DateTime?
  reviewedAt        DateTime?

  rejectionReason   String?
  additionalInfo    String?

  documents         Json?
  testResults       Json?

  expiresAt         DateTime?

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  // Relations
  providerProfile   ProviderProfile            @relation(fields:[providerProfileId], references:[id], onDelete: Cascade)

  reviewedBy        User?                      @relation("VerificationReviewer", fields:[reviewedById], references:[id])

  @@index([providerProfileId])
  @@index([reviewedById])
  @@index([status])
}

// =====================================================
// PROJECT REQUEST
// =====================================================
model ProjectRequest {
  id                 String               @id @default(uuid())

  clientId           String
  organizationId     String?
  providerId         String?

  title              String
  description        String?

  category           String?
  subcategory        String?

  status             ProjectRequestStatus @default(DRAFT)

  budgetMin          Decimal?
  budgetMax          Decimal?
  currency           String?              @default("MAD")

  startDate          DateTime?
  deadline           DateTime?

  isConfidential     Boolean              @default(false)

  requirements       Json?
  deliverables       Json?
  documents          Json?

  publicationVersion Int                  @default(1)

  submittedAt        DateTime?
  publishedAt        DateTime?
  assignedAt         DateTime?
  cancelledAt        DateTime?
  archivedAt         DateTime?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime               @updatedAt

  // Relations
  client             User                 @relation("ProjectClient", fields:[clientId], references:[id])

  organization       Organization?        @relation(fields:[organizationId], references:[id])

  provider           ProviderProfile?     @relation(fields:[providerId], references:[id])

  @@index([clientId])
  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}
